--- a/.github/workflows/daily_pipeline.yml
+++ b/.github/workflows/daily_pipeline.yml
@@ -178,17 +178,54 @@ jobs:
           git push || echo "docs_push_failed"
 
           # ── PHASE 3: Social posting ────────────────────────────────────────
-          python3 post_to_telegram.py                 || echo "telegram failed"
-          python3 post_to_twitter.py                  || echo "twitter_api failed"
-          python3 post_to_linkedin.py                 || echo "linkedin skipped"
-          python3 post_to_discord.py                  || echo "discord failed"
-          python3 post_to_reddit.py                   || echo "reddit failed"
-          python3 welcome_journey.py                  || echo "welcome_journey skipped"
-          python3 social_post.py                      || echo "social_post failed"
-          python3 build_reddit_comments.py            || echo "reddit_comments skipped"
-          python3 post_discord_daily_picks.py         || echo "discord_picks skipped"
-          python3 build_compelling_subject.py         || echo "subject skipped"
-          python3 send_partner_followup.py            || echo "partner_followup skipped"
+          # Each step used to end in `|| echo "x failed"`, which prints a line
+          # and lets the job go green. A poster can then be broken for months
+          # with every run showing success — which is exactly what happened to
+          # the Numerai score collection. `social` records each failure,
+          # annotates it so it appears in the Actions UI, and the tally below
+          # fails the job when everything is down.
+          SOCIAL_FAILED=""
+          social() {
+            local name="$1"; shift
+            if "$@"; then
+              echo "  ok   $name"
+            else
+              SOCIAL_FAILED="$SOCIAL_FAILED $name"
+              echo "::warning title=social::$name failed"
+            fi
+          }
+
+          # Voice/podcast assets. Previously generated by nothing at all:
+          # generate_voice_content.py existed in the repo but was not
+          # referenced by any workflow, so the audio the site advertises was
+          # never produced.
+          social voice_content python3 generate_voice_content.py
+
+          social telegram        python3 post_to_telegram.py
+          social twitter         python3 post_to_twitter.py
+          social linkedin        python3 post_to_linkedin.py
+          social discord         python3 post_to_discord.py
+          social reddit          python3 post_to_reddit.py
+          social welcome_journey python3 welcome_journey.py
+          social social_post     python3 social_post.py
+          social reddit_comments python3 build_reddit_comments.py
+          social discord_picks   python3 post_discord_daily_picks.py
+          social subject         python3 build_compelling_subject.py
+          social partner_followup python3 send_partner_followup.py
+
+          if [ -n "$SOCIAL_FAILED" ]; then
+            echo "::error title=social::failed:$SOCIAL_FAILED"
+            echo "=== social failures:$SOCIAL_FAILED ==="
+            # One platform down is normal and must not fail the pipeline; all
+            # of them down means credentials or the runner, not the platforms.
+            n_failed=$(echo $SOCIAL_FAILED | wc -w)
+            if [ "$n_failed" -ge 11 ]; then
+              echo "every social step failed — treating as a real outage"
+              exit 1
+            fi
+          else
+            echo "=== all social steps ok ==="
+          fi
 
           echo "=== $(date '+%F %T %Z') pipeline_end ==="
 
